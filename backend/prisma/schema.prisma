datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
  HOSTEL_OWNER
}

model User {
  id                 Int       @id @default(autoincrement())
  email              String    @unique
  passwordHash       String
  role               Role
  hashedRefreshToken String?
  
  student            Student?
  hostelOwner        HostelOwner?
  teacher            Teacher?
  adminProfile       AdminProfile?

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Student {
  id         Int       @id @default(autoincrement())
  student_id String    @unique
  firstName  String
  lastName   String
  email      String?   @unique
  
  gender         String?
  dob            String?
  enrollmentDate String?
  scholarType    String?
  
  guardianName     String?
  guardianRelation String?
  guardianPhone    String?
  guardianEmail    String?
  guardianAddress  String?
  
  userId     Int       @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  classId    Int?
  class      Class?    @relation(fields: [classId], references: [id])
  
  hostelId   Int?
  hostel     Hostel?   @relation(fields: [hostelId], references: [id])
  
  payments   Payment[]
  results    Result[]
  termAssessmentScores TermAssessmentScore[]
  attendances Attendance[]
  classHistory String?   @db.Text
  classHistoryRelations ClassHistory[]
  ranks StudentRank[]
  promotions StudentPromotion[]
  
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([student_id])
  @@index([classId])
  @@index([hostelId])
  @@index([firstName, lastName])
  @@index([email])
}

model Class {
  id         Int       @id @default(autoincrement())
  class_id   String    @unique
  name       String
  
  level      String?
  track      String?
  room       String?
  classTeacher String?
  schedule   String?
  capacity   Int?
  subjects   Json?
  timetable  Json?
  
  students   Student[]
  
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([class_id])
  @@index([name])
}

model HostelOwner {
  id        Int       @id @default(autoincrement())
  userId    Int       @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  hostels   Hostel[]
}

model Hostel {
  id        Int       @id @default(autoincrement())
  hostel_id String    @unique
  name      String
  type      String?   // "Boys" or "Girls"
  warden    String?
  wardenPhone String?
  wardenEmail String?
  capacity  Int
  
  ownerId   Int?
  owner     HostelOwner? @relation(fields: [ownerId], references: [id])
  
  students  Student[]
  
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([hostel_id])
}

model Teacher {
  id         Int       @id @default(autoincrement())
  teacher_id String    @unique
  firstName  String
  lastName   String
  email      String?   @unique
  phone      String?
  qualification String?
  
  subjects   Json?
  classes    Json?

  userId     Int       @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([teacher_id])
  @@index([firstName, lastName])
  @@index([email])
}

model Subject {
  id           Int       @id @default(autoincrement())
  subject_code String    @unique
  name         String
  department   String?
  description  String?
  
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([subject_code])
  @@index([name])
}

model Application {
  id               Int      @id @default(autoincrement())
  firstName        String
  surname          String
  gender           String
  targetClass      String
  boardingStatus   String
  previousSchool   String?
  dob              String?
  guardianTitle    String
  guardianName     String
  guardianRelation String?
  guardianAddress  String?
  whatsapp         String?
  phone            String
  email            String?
  status           String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status])
  @@index([email])
}

model FeeStructure {
  id              Int      @id @default(autoincrement())
  scholarType     String   // "Day", "Boarding"
  totalAmount     Float
  installments    Json?    // Array of amounts
  academicYear    String
  term            Int
  updatedAt       DateTime @updatedAt

  @@unique([scholarType, academicYear, term])
}

model Payment {
  id              Int      @id @default(autoincrement())
  studentId       Int
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amount          Float
  date            DateTime @default(now())
  method          String   // "Cash", "Bank Transfer", "Check"
  reference       String?  @unique
  status          String   @default("VERIFIED") // PENDING, VERIFIED
  academicYear    String
  term            Int

  // Audit: who captured this payment
  recordedBy      String?  // Display name of the user who recorded the payment
  recordedById    Int?     // User id of the recorder

  createdAt       DateTime @default(now())

  @@index([studentId])
  @@index([studentId, academicYear, term])
}

model Expense {
  id              Int      @id @default(autoincrement())
  category        String
  description     String
  amount          Float
  date            DateTime @default(now())
  status          String   @default("COMPLETED") // PENDING, COMPLETED
  attachmentUrl   String?
  
  createdAt       DateTime @default(now())

  @@index([category])
  @@index([date])
}

model SystemSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model AdminProfile {
  id          Int      @id @default(autoincrement())
  firstName   String
  lastName    String
  phone       String?
  permissions Json?
  userId      Int      @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Result {
  id           Int      @id @default(autoincrement())
  studentId    Int
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectKey   String   // e.g. "bio", "math", "eng", "chi", "phys"
  score        Float
  assessmentScores Json? // Record<assessmentId, score>
  term         Int
  academicYear String
  
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@unique([studentId, subjectKey, term, academicYear])
  @@index([studentId])
}

model GradeConfig {
  id           Int      @id @default(autoincrement())
  classId      Int
  subjectKey   String
  term         Int
  academicYear String
  config       Json     // Array of {id, name, weight, maxScore}
  
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@unique([classId, subjectKey, term, academicYear])
}

model TermAssessmentScore {
  id             Int      @id @default(autoincrement())
  studentId      Int
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectKey     String
  assessmentId   String   // the internal ID, e.g., 'test12345'
  assessmentName String   // e.g. "Test 1"
  score          Float
  maxScore       Int
  term           Int
  academicYear   String
  
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  @@unique([studentId, subjectKey, assessmentId, term, academicYear])
  @@index([studentId])
}
model PasswordResetRequest {
  id         Int      @id @default(autoincrement())
  email      String
  status     String   @default("PENDING") // PENDING, RESOLVED
  createdAt  DateTime @default(now())
  resolvedAt DateTime?

  @@index([email])
  @@index([status])
}

model SchoolFeed {
  id        Int      @id @default(autoincrement())
  title     String
  content   String   @db.Text
  images    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SchoolGallery {
  id          Int      @id @default(autoincrement())
  title       String?
  description String?  @db.Text
  imageUrl    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Attendance {
  id           Int      @id @default(autoincrement())
  studentId    Int
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date         String   // format: YYYY-MM-DD
  status       String   // "present", "absent", "late"
  term         Int
  academicYear String
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([studentId, date])
  @@index([studentId])
  @@index([date])
}

model ClassHistory {
  id           Int      @id @default(autoincrement())
  studentId    Int
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  className    String
  academicYear String

  @@unique([studentId, academicYear])
  @@index([studentId])
  @@index([className, academicYear])
}

model StudentRank {
  id            Int      @id @default(autoincrement())
  studentId     Int
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term          Int
  academicYear  String
  average       Float
  points        Int
  rank          Int
  totalStudents Int
  
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  @@unique([studentId, term, academicYear])
  @@index([studentId])
}

// One row per admin-triggered "advance year & promote" run (e.g. 2024 -> 2025).
// Unique on (fromYear, toYear) so a transition can never run twice.
model MigrationRun {
  id             Int      @id @default(autoincrement())
  fromYear       String
  toYear         String
  startedById    Int?
  promotedCount  Int      @default(0)
  pendingCount   Int      @default(0)
  completedCount Int      @default(0)
  // Counts of stale grade rows cleared from the incoming year so it starts fresh
  // (e.g. in-term scores that had been saved under the wrong academic year).
  archivedGrades Json?
  promotions     StudentPromotion[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([fromYear, toYear])
}

// Per-student outcome of a MigrationRun.
// status: promoted | pending_review | repeated | promoted_override | completed
model StudentPromotion {
  id              Int          @id @default(autoincrement())
  runId           Int
  run             MigrationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  studentId       Int
  student         Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sourceClassId   Int
  sourceClassName String
  targetClassId   Int?
  targetClassName String?
  status          String
  reasons         Json?        // { passCount, required, passMark, subjects: [{ key, score, passed }] }
  decidedById     Int?
  decidedAt       DateTime?

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([runId, studentId])
  @@index([status])
  @@index([sourceClassId])
}
